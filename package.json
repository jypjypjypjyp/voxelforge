{
  "name": "voxelforge",
  "version": "0.1.0",
  "description": "LLM-native 3D voxel modeling: core + skill/CLI + web viewer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "voxelforge": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-viewer.mjs",
    "test": "vitest run",
    "watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/three": "^0.185.4",
    "esbuild": "^0.23.1",
    "three": "^0.169.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}